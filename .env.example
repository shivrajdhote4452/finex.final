# FinEx Environment Configuration Example
# Copy this file to .env for local development. DO NOT commit actual credentials or production keys.

# ==============================================================================
# 1. APPLICATION & RUNTIME MODE
# ==============================================================================
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
APP_NAME="FinEx - Financial Excellence"

# ==============================================================================
# 2. OPERATIONAL DATABASE (PostgreSQL / Lakebase)
# ==============================================================================
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finex_db
# For local SQLite development/testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./finex.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Database Initialization & Upgrades:
# Run: python -m alembic upgrade head
# To inspect generated SQL without executing: python -m alembic upgrade head --sql

# ==============================================================================
# 3. JWT & SESSION REVOCATION (Mandatory in Production)
# ==============================================================================
# In production, must be at least 32 cryptographically random characters
JWT_SECRET_KEY=finex-dev-secret-key-minimum-32-chars-long-replace-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# 4. GOOGLE OAUTH CONFIGURATION
# ==============================================================================
# Backend Google ID Token Verification
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile Platform OAuth:
# Android: Place google-services.json in mobile/android/app/ and register debug/release SHA-1 in Google Cloud Console
# iOS: Place GoogleService-Info.plist in mobile/ios/Runner/ and configure URL schemes
# Optional override for direct token injection during automated evaluation:
GOOGLE_ID_TOKEN=

# ==============================================================================
# 5. FRONTEND & MOBILE API URL ROUTING
# ==============================================================================
# Web API Client (React Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Demo Chart Synthesizer (Option B: default false). When true, enables fallback synthesizer with prominent banner.
VITE_DEMO_SIMULATION=false

# Mobile Client Base URL (Dart String.fromEnvironment 'API_BASE_URL')
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - iOS Simulator:    http://127.0.0.1:8000/api/v1
# - Physical Device:  http://<LAN_IP>:8000/api/v1 (e.g. http://192.168.1.100:8000/api/v1)
# Note: ApiClient.normalizeBaseUrl ensures '/api/v1' appears exactly once regardless of trailing slash.

# CORS Allowed Origins
# Pydantic v2 BaseSettings deserializes complex list fields as a JSON array:
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]

# ==============================================================================
# 6. MARKET DATA MODES & TRACEABLE PROVIDERS
# ==============================================================================
# Mode options:
# - INDIA_HISTORICAL_REPLAY: Default educational Indian replay mode with SEBI 30-day lag
# - US_ALPACA_PAPER: Opt-in USD paper trading with Live IEX market data
# - INDIAN_LIVE_DATA: Reserved for future compliant integration
MARKET_DATA_MODE=INDIA_HISTORICAL_REPLAY
MARKET_DATA_PROVIDER=yfinance
MARKET_ALLOW_FIXTURES=false
SEBI_EDUCATIONAL_LAG_DAYS=30

# Optional Alpaca Paper Trading (only for US_ALPACA_PAPER mode)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ==============================================================================
# 7. GROQ AI CONFIGURATION (Primary Provider)
# ==============================================================================
# Primary fast inference provider for FinEx conversational AI
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# 7b. GOOGLE GEMINI AI CONFIGURATION (Fallback Provider)
# ==============================================================================
# Obtain key privately from Google AI Studio (https://aistudio.google.com/)
# DO NOT commit real keys to git or share in public logs.
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Active LLM provider: groq is primary, gemini is fallback
LLM_PROVIDER=groq

# ==============================================================================
# 8. ANGEL ONE SMARTAPI (only for MARKET_DATA_MODE=INDIAN_LIVE_DATA)
# ==============================================================================
ANGEL_API_KEY=YOUR_ANGEL_API_KEY_HERE
ANGEL_CLIENT_ID=YOUR_ANGEL_CLIENT_CODE_HERE
ANGEL_MPIN=YOUR_ANGEL_MPIN_HERE
ANGEL_TOTP_SECRET=YOUR_ANGEL_TOTP_SECRET_HERE

# ==============================================================================
# 9. PLATFORM OWNER & SANDBOX GOVERNANCE
# ==============================================================================
# Platform owner email authorized for developer sandbox visibility and controls.
# Non-owner users have sandbox UI elements and sandbox API endpoints strictly hidden/gated.
OWNER_EMAIL=shivrajdhote4452@gmail.com

