# FinEx Environment Configuration Example
# Copy this file to .env for local development. DO NOT commit actual credentials or production keys.

# ==============================================================================
# 1. APPLICATION & RUNTIME MODE
# ==============================================================================
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
APP_NAME="FinEx - Financial Excellence"

# ==============================================================================
# 2. OPERATIONAL DATABASE (PostgreSQL / Lakebase)
# ==============================================================================
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finex_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Database Initialization & Upgrades:
# Run: python -m alembic upgrade head
# To inspect generated SQL without executing: python -m alembic upgrade head --sql

# ==============================================================================
# 3. JWT & SESSION REVOCATION (Mandatory in Production)
# ==============================================================================
# In production, must be at least 32 cryptographically random characters
JWT_SECRET_KEY=finex-dev-secret-key-minimum-32-chars-long-replace-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# 4. GOOGLE OAUTH CONFIGURATION
# ==============================================================================
# Backend Google ID Token Verification
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Mobile Platform OAuth:
# Android: Place google-services.json in mobile/android/app/ and register debug/release SHA-1 in Google Cloud Console
# iOS: Place GoogleService-Info.plist in mobile/ios/Runner/ and configure URL schemes
# Optional override for direct token injection during automated evaluation:
GOOGLE_ID_TOKEN=

# ==============================================================================
# 5. FRONTEND & MOBILE API URL ROUTING
# ==============================================================================
# Web API Client (React Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mobile Client Base URL (Dart String.fromEnvironment 'API_BASE_URL')
# - Android Emulator: http://10.0.2.2:8000/api/v1
# - iOS Simulator:    http://127.0.0.1:8000/api/v1
# - Physical Device:  http://<LAN_IP>:8000/api/v1 (e.g. http://192.168.1.100:8000/api/v1)
# Note: ApiClient.normalizeBaseUrl ensures '/api/v1' appears exactly once regardless of trailing slash.

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ==============================================================================
# 6. TRACEABLE REAL-DATA INGESTION & AI SETTINGS
# ==============================================================================
# Market Data Provider: 'yfinance' or public REST API
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_LIVE=true
ALLOW_FIXTURE_FALLBACK=true

# AI & RAG Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=

