# FinEx Environment Configuration Example
# Copy to .env for local development. DO NOT commit actual secrets.

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
APP_NAME="FinEx - Financial Excellence"

# Database Configuration
# Local SQLite fallback allowed for unit test isolation; PostgreSQL for operational
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finex_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT & Authentication
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Market Data & AI Settings
MARKET_DATA_PROVIDER=yfinance
LLM_PROVIDER=mock
OPENAI_API_KEY=
